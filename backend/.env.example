# Copy this file to ".env" and fill in real values. Never commit the real .env file.

# MongoDB Atlas connection string
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/urlshortener?retryWrites=true&w=majority
MONGO_URI=your_mongodb_atlas_connection_string_here

# Port the Express server listens on
PORT=3000


# Production example: https://your-app.onrender.com
BASE_URL=http://localhost:3000


ALLOWED_ORIGINS=http://127.0.0.1:5500
